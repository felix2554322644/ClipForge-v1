# Primary Gemini API Key
GEMINI_API_KEY=
GEMINI_PROJECT_ID=

# Secondary/Fallback Gemini API Key (used for automatic failover and pool rotation)
GEMINI_API_KEY_2=
GEMINI_PROJECT_ID_2=

# Tertiary Gemini API Key (third independent project/account in router pool)
GEMINI_API_KEY_3=
GEMINI_PROJECT_ID_3=

# Centralized Gemini Model
GEMINI_MODEL=gemini-3.6-flash

# Centralized Gemini Usage Governor Limits
CLIPFORGE_MAX_GEMINI_REQUESTS=12
CLIPFORGE_MAX_SEARCH_ROUNDS=2
CLIPFORGE_MAX_CANDIDATES_TOTAL=20
CLIPFORGE_MAX_CANDIDATES_PER_SEARCH=10
CLIPFORGE_MAX_CANDIDATE_EVALUATIONS=12
CLIPFORGE_MAX_DIRECTOR_CALLS=2
CLIPFORGE_MAX_QC_CALLS=1

# Stock Footage Provider Keys
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Video Topic: Explicit topic string or 'automatic' for curated pool rotation
VIDEO_TOPIC=automatic

# Output and Model Paths
OUTPUT_DIR=artifacts
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
ALLOW_FALLBACKS=false
