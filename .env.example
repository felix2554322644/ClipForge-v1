# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PEXELS_API_KEY: Optional API key for Pexels B-roll search and download.
# If omitted, pipeline uses deterministic high-contrast procedural video generator.
PEXELS_API_KEY=""

# PIPER_PATH: Optional path to local piper TTS binary (e.g. /usr/local/bin/piper or piper)
PIPER_PATH=""

# PIPER_MODEL: Path to piper onnx voice model (e.g. ./models/en_US-lessac-medium.onnx)
PIPER_MODEL=""

# FFMPEG_PATH: Path to ffmpeg binary (default: ffmpeg)
FFMPEG_PATH="ffmpeg"

# FFPROBE_PATH: Path to ffprobe binary (default: ffprobe)
FFPROBE_PATH="ffprobe"

# OUTPUT_DIR: Directory for finished videos and stage artifacts
OUTPUT_DIR="./output"

# CACHE_DIR: Local cache for downloaded B-roll footage
CACHE_DIR="./cache"
